clc;
clear;
close all;
% ---------------- PARAMETERS ----------------
fs = 1000; % Sampling frequency (Hz)
t = 0:1/fs:1-1/fs; % Time vector (1 sec)
f = 5; % Signal frequency (Hz)
A = 2; % Signal amplitude
% ---------------- ORIGINAL SIGNAL ----------------
signal = A * sin(2*pi*f*t);
% ---------------- NOISE GENERATION ----------------
noise_amp = 0.5; % Noise amplitude (std deviation)
noise = noise_amp * randn(size(t)); % White Gaussian Noise
% ---------------- NOISY SIGNAL ----------------
signal_noisy = signal + noise;
% ---------------- SNR CALCULATION ----------------
signal_power = mean(signal.^2);
noise_power = mean(noise.^2);
snr_val = 10 * log10(signal_power / noise_power);
% ---------------- NOISE FIGURE ----------------
snr_in_db = 20; % Assumed input SNR (dB)
snr_out_db = snr_val;
noise_figure = snr_in_db - snr_out_db;
% ---------------- DISPLAY ----------------
fprintf('Calculated SNR = %.2f dB\n', snr_val);
fprintf('Noise Figure = %.2f dB\n', noise_figure);
% ---------------- VISUALIZATION ----------------
figure;
subplot(3,1,1);
plot(t, signal, 'LineWidth', 1.5);
title('Original Signal');
ylabel('Amplitude');
grid on;
subplot(3,1,2);
plot(t, noise, 'r');
title('White Gaussian Noise');
ylabel('Amplitude');
grid on;
subplot(3,1,3);
plot(t, signal_noisy, 'k');
title('Signal with Noise');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;
